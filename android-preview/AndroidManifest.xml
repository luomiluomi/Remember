<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.remember.preview" android:versionCode="32" android:versionName="0.3.18-preview">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <application android:label="@string/app_name" android:icon="@drawable/remember_supplied" android:allowBackup="false" android:usesCleartextTraffic="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".PreviewActivity" android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
        </activity>
        <activity-alias android:name=".LauncherRemember" android:targetActivity=".PreviewActivity" android:enabled="true" android:exported="true" android:label="记得" android:icon="@drawable/remember_supplied">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias android:name=".LauncherMemory" android:targetActivity=".PreviewActivity" android:enabled="false" android:exported="true" android:label="Memory" android:icon="@drawable/memory_alternative">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
    </application>
</manifest>


